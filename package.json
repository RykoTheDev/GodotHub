{
  "name": "godothub",
  "private": true,
  "version": "1.5.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "lint": "eslint",
    "i18n:check": "node scripts/check-keys.cjs",
    "i18n:types": "node scripts/generate-i18n-types.cjs",
    "i18n:add": "node scripts/i18n-add.cjs",
    "i18n:sync": "node scripts/i18n-sync.cjs",
    "i18n:unused": "node scripts/find-unused-keys.cjs",
    "i18n:remove-unused": "node scripts/remove-unused-keys.cjs",
    "i18n:dupes": "node scripts/check-duplicate-keys.mjs",
    "validate": "tsc --noEmit && bun run i18n:check -- --check-values",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/google-sans-code": "^5.3.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@number-flow/react": "^0.6.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "country-flag-icons": "^1.6.20",
    "gsap": "^3.15.0",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
